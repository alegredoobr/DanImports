# Copie este arquivo para .env.local (desenvolvimento) e cadastre as mesmas
# duas variáveis na Vercel (Settings > Environment Variables).
#
# Encontre os valores no Supabase: Project Settings > API.
# Use SOMENTE a chave "anon" / "publishable". NUNCA use a "service_role" aqui.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-publica
